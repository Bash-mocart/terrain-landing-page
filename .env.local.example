# Local Go API (docker-compose). Use http://localhost:8080 for `go run`.
NEXT_PUBLIC_TERRAIN_API_URL=http://localhost:8090

# Public Mapbox browser token (`pk...`). Never place a secret `sk...` token here.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Cloudflare Turnstile site key (public). Empty = no widget; the local API's check is off too. |Thank you
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
